# --- Build output ---
out/
*.tsbuildinfo

# --- Packaging artifacts ---
*.vsix

# --- Dependencies ---
node_modules/

# --- Logs & debug ---
*.log
npm-debug.log*
logs/

# --- Backup files from patch scripts ---
*.bak*
*.bak-tlsgit

# --- OS junk ---
Thumbs.db
.DS_Store
Desktop.ini

# --- Editor state (NOT the settings with your key!) ---
.vscode

# --- Local env / secrets ---
.env
.env.*
*.local
project-bundle*

# --- AI Agent Chat runtime state ---
# The session snapshot (conversation history) is per-machine runtime state;
# it is regenerated locally and should not be shared/committed.
# NOTE: the agent's memory file (AGENTS.md by default) is intentionally NOT
# ignored — it holds shared cross-session understanding you may want in VCS.
.ai-agent-chat/
