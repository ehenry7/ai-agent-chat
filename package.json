{
  "name": "ai-agent-chat",
  "displayName": "AI Chat",
  "description": "Agentic AI chat for OpenAI-compatible APIs with file and shell tools. No runtime dependencies; TLS verification enabled. Remote-SSH ready.",
  "version": "0.30.4",
  "publisher": "Huawei",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-agent-chat",
          "title": "AI Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ai-agent-chat": [
        {
          "type": "webview",
          "id": "ai-agent-chat.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "aiAgentChat.showWelcome",
        "title": "AI Agent Chat: Show Setup Screen",
        "icon": "media/icon.svg"
      },
      {
        "command": "aiAgentChat.open",
        "title": "AI Agent Chat: Open",
        "icon": "media/icon.svg"
      },
      {
        "command": "aiAgentChat.setApiKey",
        "title": "AI Agent Chat: Set API Key"
      },
      {
        "command": "aiAgentChat.clearApiKey",
        "title": "AI Agent Chat: Clear API Key"
      },
      {
        "command": "aiAgentChat.diagnostics",
        "title": "AI Agent Chat: Show Diagnostics"
      }
    ],
    "configuration": {
      "title": "AI Agent Chat",
      "properties": {
        "aiAgentChat.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the OpenAI-compatible API (e.g. https://api.openai.com/v1)",
          "scope": "resource"
        },
        "aiAgentChat.model": {
          "type": "string",
          "default": "GLM-5.2-1",
          "description": "Default model name (models can be queried from the server and switched dynamically in the chat view)",
          "scope": "resource"
        },
        "aiAgentChat.webSearchUrl": {
          "type": "string",
          "default": "https://duckduckgo.com/html/?q=%s",
          "description": "Search engine URL template used by the agent's web_search tool. %s is replaced with the URL-encoded query. Point this at an internal search engine if public internet access is unavailable.",
          "scope": "resource"
        },
        "aiAgentChat.apiKeyEnvVar": {
          "type": "string",
          "default": "",
          "description": "Environment variable name to read the API key from (e.g., OPENAI_API_KEY). Overrides SecretStorage if set.",
          "scope": "resource"
        },
        "aiAgentChat.maxSteps": {
          "type": "number",
          "default": 25,
          "minimum": 2,
          "maximum": 500,
          "description": "Maximum number of agent loop steps (model calls) per chat turn before the agent stops itself.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "build": "node build.js",
    "rebuild": "node build.js ",
    "build:fast": "node build.js --no-install --skip-deps",
    "build:no-deps": "node build.js --skip-deps",
    "test": "tsc -p ./ && node --require ./test/register-vscode-stub.js --test out/test"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}